---
// A man page section: an upper-case name with an indented body.
interface Props {
  name: string;
}
const { name } = Astro.props;
const id = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section class="sect" aria-labelledby={id}>
  <h2 id={id}>{name}</h2>
  <div class="body">
    <slot />
  </div>
</section>
